<%- include('partials/header', { title: 'Set New Password' }) %>

<div class="form-container" style="max-width: 480px;">
  <div class="form-header">
    <h1 class="form-title">Set New Password</h1>
    <p class="form-subtitle">Choose a new secure password for your account.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger">
      <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
    </div>
  <% } %>

  <form action="/reset-password/<%= token %>" method="POST">
    <div class="form-group">
      <label for="password" class="form-label">New Password *</label>
      <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required minlength="6">
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
      <i class="fa-solid fa-check"></i> Update Password
    </button>
  </form>
</div>

<%- include('partials/footer') %>
