<%- include('partials/header', { title: 'Create New Post' }) %>

<div class="form-container">
  <div class="form-header">
    <h1 class="form-title">Create New Article</h1>
    <p class="form-subtitle">Share your insights, code, or thoughts with the community.</p>
  </div>

  <div class="ai-banner">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
      <div>
        <strong style="color: #a5b4fc; font-size: 0.95rem; display: flex; align-items: center; gap: 0.4rem;">
          <i class="fa-solid fa-wand-magic-sparkles"></i> ADK-TS AI Writer
        </strong>
        <span style="font-size: 0.85rem; color: var(--text-muted);">
          Generate a complete Markdown article using AI Agent technology.
        </span>
      </div>
      <button type="button" id="toggleAiBoxBtn" class="btn btn-primary" style="padding: 0.4rem 0.9rem; font-size: 0.85rem; background: linear-gradient(135deg, #8b5cf6, #06b6d4);">
        <i class="fa-solid fa-sparkles"></i> Draft with AI
      </button>
    </div>

    <div id="aiInputBox" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.1);">
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <input type="text" id="aiTopicInput" class="form-control" placeholder="Enter topic e.g. Future of PostgreSQL and Node.js in 2026..." style="flex: 1; min-width: 200px;">
        <button type="button" id="generateAiBtn" class="btn btn-primary" style="white-space: nowrap;">
          <span id="generateBtnText"><i class="fa-solid fa-bolt"></i> Generate Draft</span>
          <span id="generateBtnSpinner" style="display: none;"><i class="fa-solid fa-spinner fa-spin"></i> Generating...</span>
        </button>
      </div>
      <div id="aiStatusMessage" style="font-size: 0.82rem; margin-top: 0.5rem; display: none;"></div>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" style="margin-bottom: 1.5rem;">
      <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
    </div>
  <% } %>

  <form action="/create-blog" method="POST">
    <div class="form-group">
      <label for="title" class="form-label">Article Title *</label>
      <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Master Modern Web Design in 2026" required>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="category" class="form-label">Category</label>
        <select id="category" name="category" class="form-control">
          <option value="Technology">Technology</option>
          <option value="Design">Design</option>
          <option value="Development" selected>Development</option>
          <option value="Lifestyle">Lifestyle</option>
          <option value="General">General</option>
        </select>
      </div>

      <div class="form-group">
        <label for="author" class="form-label">Author Name</label>
        <% if (typeof user !== 'undefined' && user) { %>
          <input type="text" id="author" name="author" class="form-control" value="<%= user.username %>" readonly style="background: rgba(99, 102, 241, 0.15); border-color: var(--primary); font-weight: 600;">
          <small style="color: var(--primary); font-size: 0.8rem; display: block; margin-top: 0.25rem;">
            <i class="fa-solid fa-user-check"></i> Logged in as <strong>@<%= user.username %></strong> <%= user.isEmailVerified ? '(Verified Author)' : '(Unverified Email)' %>
          </small>
        <% } else { %>
          <input type="text" id="author" name="author" class="form-control" placeholder="e.g. Guest Writer" required>
          <small style="color: var(--text-subtle); font-size: 0.8rem; display: block; margin-top: 0.25rem;">
            Posting as guest. <a href="/login" style="color: var(--primary);">Sign in</a> to get a Verified Author badge.
          </small>
        <% } %>
      </div>
    </div>

    <div class="form-group">
      <label for="coverImage" class="form-label">Cover Image URL (Optional)</label>
      <input type="url" id="coverImage" name="coverImage" class="form-control" placeholder="https://images.unsplash.com/photo-...">
    </div>

    <div class="form-group">
      <label for="content" class="form-label">Article Body Content (Markdown Supported) *</label>
      <textarea id="content" name="content" class="form-control" placeholder="Write in Markdown... # Headings, **bold**, *italics*, `code`, [links](url), - lists" required></textarea>
      <small style="color: var(--text-subtle); font-size: 0.8rem; display: block; margin-top: 0.35rem;">
        <i class="fa-brands fa-markdown"></i> Markdown supported: <code># Heading</code>, <code>**bold**</code>, <code>*italics*</code>, <code>\`code\`</code>, <code>[link](url)</code>, <code>- list</code>
      </small>
    </div>

    <div class="form-actions" style="display: flex; gap: 0.75rem; align-items: center; justify-content: flex-end;">
      <a href="/" class="btn btn-secondary">Cancel</a>

      <% if (typeof user !== 'undefined' && user) { %>
        <button type="submit" name="status" value="draft" class="btn btn-secondary" style="border-color: rgba(234, 179, 8, 0.4); color: #fef08a;">
          <i class="fa-solid fa-floppy-disk"></i> Save as Draft
        </button>
      <% } %>

      <button type="submit" name="status" value="published" class="btn btn-primary">
        <i class="fa-solid fa-paper-plane"></i> Publish Post
      </button>
    </div>
  </form>
</div>

<script>
  document.getElementById("toggleAiBoxBtn").addEventListener("click", () => {
    const box = document.getElementById("aiInputBox");
    box.style.display = box.style.display === "none" ? "block" : "none";
  });

  document.getElementById("generateAiBtn").addEventListener("click", async () => {
    const topic = document.getElementById("aiTopicInput").value.trim();
    const statusMsg = document.getElementById("aiStatusMessage");
    const btnText = document.getElementById("generateBtnText");
    const btnSpinner = document.getElementById("generateBtnSpinner");

    if (!topic) {
      statusMsg.style.display = "block";
      statusMsg.style.color = "#fca5a5";
      statusMsg.textContent = "Please enter a topic prompt.";
      return;
    }

    btnText.style.display = "none";
    btnSpinner.style.display = "inline-block";
    statusMsg.style.display = "block";
    statusMsg.style.color = "#a5b4fc";
    statusMsg.textContent = "Connecting to ADK-TS AI Agent...";

    try {
      const res = await fetch("/api/ai/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ topic })
      });
      const data = await res.json();

      if (data.success) {
        document.getElementById("title").value = data.title;
        document.getElementById("category").value = data.category || "Development";
        document.getElementById("content").value = data.content;

        statusMsg.style.color = "#6ee7b7";
        statusMsg.textContent = "✨ Article draft generated by ADK-TS Agent!";
      } else {
        statusMsg.style.color = "#fca5a5";
        statusMsg.textContent = data.error || "Failed to generate article.";
      }
    } catch (err) {
      statusMsg.style.color = "#fca5a5";
      statusMsg.textContent = "Network error connecting to AI endpoint.";
    } finally {
      btnText.style.display = "inline-block";
      btnSpinner.style.display = "none";
    }
  });
</script>

<%- include('partials/footer') %>
