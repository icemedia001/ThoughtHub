<%- include('partials/header', { title: post.title }) %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<article class="post-detail">
  <a href="/" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to Articles</a>

  <header class="post-header">
    <div class="card-meta">
      <span class="badge" style="position:static;"><%= post.category || 'General' %></span>
      <span>•</span>
      <span><i class="fa-regular fa-calendar"></i> <%= post.createdAt %></span>
      <span>•</span>
      <span><i class="fa-regular fa-clock"></i> <%= post.readTime || '3 min read' %></span>
    </div>

    <h1 class="post-detail-title"><%= post.title %></h1>

    <div class="post-detail-meta">
      <div class="author-info">
        <div class="avatar" style="width:40px; height:40px; font-size:1.1rem;"><%= post.author ? post.author.charAt(0).toUpperCase() : 'A' %></div>
        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="author-name" style="font-size: 1.05rem;"><%= post.author || 'Anonymous' %></span>
            <% if (post.isVerified) { %>
              <span class="verified-tag" style="font-size: 0.8rem;"><i class="fa-solid fa-circle-check"></i> Verified Author</span>
            <% } %>
          </div>
          <div style="font-size: 0.8rem; color: var(--text-subtle);">
            <%= post.isVerified ? 'Registered & Verified Account' : 'Guest Contributor' %>
          </div>
        </div>
      </div>

      <div class="card-actions">
        <button type="button" id="summarizeAiBtn" class="btn btn-secondary" style="border-color: rgba(99, 102, 241, 0.4); color: #a5b4fc;">
          <span id="summarizeBtnText"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Summary</span>
          <span id="summarizeBtnSpinner" style="display: none;"><i class="fa-solid fa-spinner fa-spin"></i> Summarizing...</span>
        </button>
        <a href="/post/<%= post.id %>/edit" class="btn btn-secondary"><i class="fa-solid fa-pen"></i> Edit Article</a>
        <form action="/post/<%= post.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this post?');">
          <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash"></i> Delete</button>
        </form>
      </div>
    </div>
  </header>

  <div id="aiSummaryCard" class="ai-summary-card" style="display: none;">
    <div class="ai-summary-header">
      <i class="fa-solid fa-sparkles" style="color: #67e8f9;"></i>
      <strong>ADK-TS AI Key Takeaways</strong>
    </div>
    <div id="aiSummaryBody" class="ai-summary-body"></div>
  </div>

  <% if (post.coverImage) { %>
    <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="post-cover-image">
  <% } %>

  <div class="post-content" id="postArticleContent">
    <%- parseMarkdown(post.content) %>
  </div>
</article>

<script>
  document.getElementById("summarizeAiBtn").addEventListener("click", async () => {
    const title = `<%= post.title %>`;
    const content = document.getElementById("postArticleContent").innerText;
    const summaryCard = document.getElementById("aiSummaryCard");
    const summaryBody = document.getElementById("aiSummaryBody");
    const btnText = document.getElementById("summarizeBtnText");
    const btnSpinner = document.getElementById("summarizeBtnSpinner");

    btnText.style.display = "none";
    btnSpinner.style.display = "inline-block";

    try {
      const res = await fetch("/api/ai/summarize", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title, content })
      });
      const data = await res.json();

      summaryCard.style.display = "block";
      if (data.success) {
        if (typeof marked !== "undefined" && marked.parse) {
          summaryBody.innerHTML = marked.parse(data.summary);
        } else {
          summaryBody.innerHTML = `<div style="white-space: pre-line;">${data.summary}</div>`;
        }
      } else {
        summaryBody.innerHTML = `<span style="color: #fca5a5;">${data.error || "Failed to generate summary."}</span>`;
      }
    } catch (err) {
      summaryCard.style.display = "block";
      summaryBody.innerHTML = `<span style="color: #fca5a5;">Network error connecting to AI endpoint.</span>`;
    } finally {
      btnText.style.display = "inline-block";
      btnSpinner.style.display = "none";
    }
  });
</script>

<%- include('partials/footer') %>
