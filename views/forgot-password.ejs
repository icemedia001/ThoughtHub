<%- include('partials/header', { title: 'Forgot Password' }) %>

<div class="form-container" style="max-width: 480px;">
  <div class="form-header">
    <h1 class="form-title">Reset Your Password</h1>
    <p class="form-subtitle">Enter your account email to receive a password recovery link.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger">
      <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
    </div>
  <% } %>

  <% if (typeof resetLink !== 'undefined' && resetLink) { %>
    <div class="alert alert-info" style="display: block;">
      <% if (typeof mailSent !== 'undefined' && mailSent) { %>
        <div style="font-weight: 600; margin-bottom: 0.5rem;"><i class="fa-solid fa-paper-plane"></i> Recovery Email Dispatched!</div>
        <p style="margin-bottom: 0.5rem;">We sent a password reset email to <strong><%= typeof targetEmail !== 'undefined' ? targetEmail : '' %></strong> via Gmail SMTP.</p>
      <% } else { %>
        <div style="font-weight: 600; margin-bottom: 0.5rem;"><i class="fa-solid fa-envelope"></i> Password Reset Link Generated</div>
        <p style="margin-bottom: 0.5rem;">To deliver emails directly to user inboxes, configure your Gmail address and App Password in <code>.env</code>.</p>
      <% } %>
      <a href="<%= resetLink %>" class="btn btn-secondary" style="display: inline-block; word-break: break-all; margin-top: 0.5rem;">
        <i class="fa-solid fa-key"></i> Reset Password Link
      </a>
    </div>
  <% } else { %>
    <form action="/forgot-password" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">Account Email Address *</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="you@example.com" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
        <i class="fa-solid fa-paper-plane"></i> Send Recovery Link
      </button>

      <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
        Remember your password? <a href="/login" style="color: var(--primary); font-weight: 600;">Back to Sign In</a>
      </div>
    </form>
  <% } %>
</div>

<%- include('partials/footer') %>
